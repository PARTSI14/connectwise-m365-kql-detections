// CW-04 | Application adds credentials (secret or certificate) to ANOTHER application
// Observed ("secret planting"): after becoming Global Administrator, a ConnectWise app added new
// credentials to other applications in the tenant, including a security vendor's app, to keep access.
// Table: AuditLogs | ATT&CK: T1098.001 Additional Cloud Credentials
// Note: the application operation name contains an en dash and may end with a space, so match on "has".
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName has "Add service principal credentials"
     or OperationName has "Certificates and secrets management"
| extend InitiatorSpId   = tostring(InitiatedBy.app.servicePrincipalId),
         InitiatorSpName = tostring(InitiatedBy.app.displayName),
         InitiatorUser   = tostring(InitiatedBy.user.userPrincipalName),
         TargetId        = tostring(TargetResources[0].id),
         TargetName      = tostring(TargetResources[0].displayName)
| where isnotempty(InitiatorSpId)                 // change made by an application, not a person
| where InitiatorSpId != TargetId                 // ...to a different application
| project TimeGenerated, OperationName, InitiatorSpName, InitiatorSpId, TargetName, TargetId, Result, CorrelationId
| order by TimeGenerated asc
