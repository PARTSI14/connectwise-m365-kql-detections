// CW-07 (hunting) | Bulk secret reads from Azure Key Vault by an application identity
// Reported: Microsoft Defender for Cloud detected bulk secret reads across several Key Vaults using a
// compromised multi-tenant application.
// Table: AzureDiagnostics (Key Vault diagnostic logs, AuditEvent category) | ATT&CK: T1555.006
// Column names depend on your diagnostic-settings mode; adjust if you use resource-specific tables.
AzureDiagnostics
| where TimeGenerated > ago(30d)
| where ResourceProvider == "MICROSOFT.KEYVAULT" and OperationName == "SecretGet"
| summarize SecretsRead = dcount(id_s), Vaults = dcount(Resource), Reads = count(),
            FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by CallerAppId = identity_claim_appid_g, CallerIPAddress, bin(TimeGenerated, 1h)
| where SecretsRead >= 20 or Vaults >= 3
| order by SecretsRead desc
