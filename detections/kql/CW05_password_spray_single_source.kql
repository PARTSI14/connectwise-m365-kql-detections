// CW-05 | Password spraying from a single source
// Observed: 10-14 Oct 2026, 327 accounts at eight organisations, >151,000 failed logons, peaking at
// ~2,900 failures per minute (machine speed, ARTEX-driven per Microsoft).
// Table: SigninLogs | ATT&CK: T1110.003 Password Spraying
// Tune the thresholds to your tenant size.
let lookback = 1d;
let MinAccounts = 15;     // distinct accounts tried from one IP
let MinFailures = 50;
let FailureCodes = dynamic(["50126", "50053", "50055", "50056"]); // bad password, locked, expired, invalid/null password
let Failed = SigninLogs
    | where TimeGenerated > ago(lookback)
    | where ResultType in (FailureCodes);
let Peak = Failed
    | summarize PerMinute = count() by IPAddress, bin(TimeGenerated, 1m)
    | summarize PeakPerMinute = max(PerMinute) by IPAddress;
Failed
| summarize Failures = count(), Accounts = dcount(UserPrincipalName),
            FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated),
            SampleAccounts = make_set(UserPrincipalName, 20), Apps = make_set(AppDisplayName, 10)
    by IPAddress, AutonomousSystemNumber
| where Accounts >= MinAccounts and Failures >= MinFailures
| join kind=leftouter Peak on IPAddress
| project-away IPAddress1
| order by PeakPerMinute desc
